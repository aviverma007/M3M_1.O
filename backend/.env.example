# ---------- copy this file to .env and fill in real values ----------

# HTTP
PORT=5000
# public base path of the API (the frontend uses /api/v1)
API_PREFIX=/api/v1
# serve the built frontend (../frontend/dist) from this server: true | false
SERVE_FRONTEND=true

# SQL Server (the M3M_One database created by database/01_create_database.sql)
DB_SERVER=localhost
# leave empty for a default instance; e.g. SQLEXPRESS for a named instance
DB_INSTANCE=
DB_PORT=1433
DB_NAME=M3M_One
DB_USER=m3m_app
DB_PASSWORD=Change_This_Str0ng_Password!
# true if the SQL Server certificate isn't trusted by this machine (typical on a LAN server)
DB_TRUST_SERVER_CERTIFICATE=true
DB_ENCRYPT=true

# Auth — use a long random string (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=12h

# Where uploaded files are stored (created if missing). Back this folder up with the database.
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=25

# Public URL of this app, used in password-reset emails (e.g. http://192.168.66.28:5000)
APP_URL=http://localhost:5000

# Optional SMTP for password-reset emails (if empty, reset links are written to the server log)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=M3M_1.O <no-reply@example.com>
